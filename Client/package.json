{
  "name": "hiv-platform",
  "version": "3.1.0",
  "description": "HIV Platform",
  "exports": "./index.js",
  "sideEffects": [
    "./src/utilities/*.js"
  ],
  "browserslist": [
    "> 5% and last 2 versions",
    "not IE 11"
  ],
  "scripts": {
    "start": "cross-env NODE_ENV=development webpack serve",
    "build": "cross-env NODE_ENV=production webpack",
    "build-watch": "cross-env NODE_ENV=production webpack --watch",
    "build-stats": "cross-env NODE_ENV=production webpack --profile --json=./analyze/compilation-stats.json",
    "build-analyze": "webpack-bundle-analyzer ./analyze/compilation-stats.json ./build --mode 'static' --report ./analyze/report.html"
  },
  "repository": "https://github.com/EU-ECDC/hivPlatform",
  "author": "NextPage Software Daniel Lewandowski",
  "license": "EUPL-1.2",
  "engines": {
    "node": ">=13.11",
    "yarn": ">=1.22.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.7",
    "@mui/lab": "^5.0.0-alpha.175",
    "@mui/material": "^6.4.7",
    "@mui/system": "^6.4.7",
    "@types/react": "^19.0.10",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.3",
    "file-saver": "^2.0.5",
    "jquery": "^3.7.1",
    "lodash": "^4.17.21",
    "mobx": "^6.13.6",
    "mobx-react": "^9.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "serializr": "^3.0.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@types/webpack-merge": "^5.0.0",
    "babel-loader": "^10.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "cross-env": "^7.0.3",
    "file-loader": "^6.2.0",
    "filemanager-webpack-plugin": "^8.0.0",
    "html-webpack-plugin": "^5.6.3",
    "terser-webpack-plugin": "^5.3.14",
    "webpack": "^5.98.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0",
    "webpack-merge": "^6.0.1",
    "webpack-plugin-modern-npm": "^0.1.0"
  },
  "packageManager": "yarn@4.7.0"
}
